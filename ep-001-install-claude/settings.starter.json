{
  "permissions": {
    "defaultMode": "bypassPermissions",
    "deny": [
      "Bash(rm -rf /)",
      "Bash(rm -rf /*)",
      "Bash(rm -rf ~)",
      "Bash(rm -rf $HOME)",
      "Bash(sudo rm -rf /)",
      "Bash(diskutil eraseDisk)",
      "Bash(diskutil eraseVolume)",
      "Bash(diskutil partitionDisk)",
      "Bash(diskutil apfs deleteContainer)",
      "Bash(diskutil apfs deleteVolume)",
      "Bash(dd of=/dev/disk)",
      "Bash(dd if=/dev/zero of=/dev/disk)",
      "Bash(git push --force)",
      "Bash(git reset --hard)",
      "Bash(git clean -fdx)",
      "Bash(security dump-keychain)",
      "Bash(chmod -R 777 /)"
    ]
  }
}
